Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.991475497434716*^9},
 CellLabel->
  " Out[28]=",ExpressionUUID->"56973416-bd22-4ee9-a794-0fa759ec1a0d"]
}, Open  ]],

Cell["\<\
Figure 9.4  Thermal-gradient fission (1D Cahn\[Dash]Hilliard, NDSolve). (a) \
At uniform temperature a single domain persists. (b) A central warm band, \
where the well depth a(x) dips below zero, dissolves the neck and splits the \
domain into two daughters \[LongDash] membrane-free division.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"0fd0a0c5-1c18-439d-bf51-ee94218961e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.5  The dispersion surface", "Subsection",ExpressionUUID->"b93f83ad-44da-48bb-9f0c-e96dce2b8225"],

Cell[TextData[{
 "Finally, the linear-stability result of \[Section]8 viewed as a surface: \
the growth rate ",
 StyleBox["\[Omega](k,\[Phi]_0)",
  FontFamily->"Times",
  FontSlant->Italic],
 " over the whole plane of wavenumber and composition, with the \
neutral-stability ridge ",
 StyleBox["\[Omega]=0",
  FontFamily->"Times",
  FontSlant->Italic],
 " marking the boundary of the unstable region."
}], "Text",ExpressionUUID->"501e3fe6-026f-4661-bff7-45be1e287ebc"],

