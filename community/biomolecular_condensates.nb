}, Open  ]],

Cell[TextData[{
 "Figure 10.3  Chemostat competition (",
 StyleBox["NDSolve",
  FontFamily->"Courier"],
 "). Left: the population's mean fitness ",
 StyleBox["\[LeftAngleBracket]g\[RightAngleBracket]",
  FontFamily->"Times",
  FontSlant->Italic],
 " rises toward ",
 StyleBox["g_max",
  FontFamily->"Times",
  FontSlant->Italic],
 " as fitter replicators take over. Right: the fittest genotype out-competes \
the rest \[LongDash] competitive exclusion, with no biology hand-coded."
}], "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"23634822-ca2d-4274-9c30-6732952fd7ba"],

