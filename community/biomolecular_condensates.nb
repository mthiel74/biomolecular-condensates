Cell[BoxData[
 RowBox[{"figReactionEnhancement", "[", "]"}]], "Input",
 CellLabel->
  " In[24]:=",ExpressionUUID->"889ab2df-5b68-4bb2-91fe-e8c7a9571549"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
