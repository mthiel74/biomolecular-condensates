Cell["\<\
Figure 8.1  Cahn\[Dash]Hilliard dispersion relation for the \
Flory\[Dash]Huggins free energy (\[Chi] = 1.5). Curves with a positive lobe \
are unstable; dots mark the fastest-growing mode k*. As the mean composition \
\[Phi]\:2080 approaches the spinodal edge, the growth rate collapses to zero \
and the selected wavelength diverges.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"686e79b3-d961-4ae0-b35c-e67ff8906116"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2  Mode selection across the parameter plane", "Subsection",ExpressionUUID->"5fb5e1ef-9ffc-4046-a55f-9628326e4021"],

Cell[TextData[{
 "The selected wavelength ",
 StyleBox["\[Lambda]* = 2\[Pi] sqrt(2\[Kappa]/(-f\[Prime]\[Prime]))",
  FontFamily->"Times",
  FontSlant->Italic],
 " grows with the surface-tension parameter ",
 StyleBox["\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 " and diverges at the spinodal boundary, where ",
 StyleBox["f\[Prime]\[Prime] \[Rule] 0",
  FontFamily->"Times",
  FontSlant->Italic],
 ". The map below shows how the length scale is selected jointly by \
composition and ",
 StyleBox["\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 "."
}], "Text",ExpressionUUID->"8d63e1de-a826-48dc-a2d9-a00bc688fe9f"],

