Cell[CellGroupData[{

Cell["2.2  Spinodal and binodal: the phase diagram", "Subsection",ExpressionUUID->"fa22eac5-8ae9-4dbf-b5c8-8b7e332b3eb3"],

Cell[TextData[{
 "The thermodynamic stability of the mixed state is determined by the \
curvature of the free energy. The ",
 StyleBox["spinodal",
  FontWeight->Bold],
 " is the locus of inflection points:"
}], "Text",ExpressionUUID->"58fd4de5-7c0c-4ea7-8c69-dad7ad5e86e1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "f"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["\[Phi]", "2"]}]], "=", 
   FractionBox["1", 
    RowBox[{
     SubscriptBox["N", "1"], " ", "\[Phi]"}]], "+", 
   FractionBox["1", 
    RowBox[{
     SubscriptBox["N", "2"], " ", "(", 
     RowBox[{"1", "-", "\[Phi]"}], ")"}]], "-", 
   RowBox[{"2", "\[Chi]"}], "=", "0"}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"f15aff57-94e3-40c7-9b1c-641b202f0904"],

Cell[TextData[{
 "Inside the spinodal, the free energy has negative curvature (",
 StyleBox["\[PartialD]\.b2f/\[PartialD]\[Phi]\.b2 < 0",
  FontFamily->"Times",
  FontSlant->Italic],
 ") and the system is ",
 StyleBox["unstable",
  FontWeight->Bold],
 " to infinitesimal composition fluctuations \[LongDash] this is ",
 StyleBox["spinodal decomposition",
  FontWeight->Bold],
 ". Between the spinodal and the ",
 StyleBox["binodal",
  FontWeight->Bold],
 " (the coexistence curve), the system is ",
 StyleBox["metastable",
  FontWeight->Bold],
 " \[LongDash] it requires a finite-amplitude fluctuation (nucleation) to \
phase-separate."
}], "Text",ExpressionUUID->"754ad2ed-d9bf-462d-a2be-414391c5e584"],

Cell[TextData[{
 "The binodal is found by the ",
 StyleBox["common tangent construction",
  FontWeight->Bold],
 ": the two coexisting compositions \[Phi]\:2097 and \[Phi]\:1d48 satisfy \
equal chemical potential and equal osmotic pressure:"
}], "Text",ExpressionUUID->"0a3869e7-b1b8-4c45-a025-d7f4aecdd7e7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Mu]", "(", 
    SubscriptBox["\[Phi]", "L"], ")"}], "=", 
   RowBox[{"\[Mu]", "(", 
    SubscriptBox["\[Phi]", "R"], ")"}], ",", "     ", 
   RowBox[{"\[CapitalPi]", "(", 
    SubscriptBox["\[Phi]", "L"], ")"}], "=", 
   RowBox[{"\[CapitalPi]", "(", 
    SubscriptBox["\[Phi]", "R"], ")"}]}], TraditionalForm]], "DisplayFormula",\

 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"a75ade4c-017c-4c06-a2e1-bbee7fbc472a"],

Cell[TextData[{
 "The ",
 StyleBox["critical point",
  FontWeight->Bold],
 " is where the spinodal and binodal meet:"
}], "Text",ExpressionUUID->"4649b62d-682b-47e2-a891-6d3ca8beb7d0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Phi]", "c"], "=", 
   FractionBox[
    SqrtBox[
     SubscriptBox["N", "2"]], 
    RowBox[{
     SqrtBox[
      SubscriptBox["N", "1"]], "+", 
     SqrtBox[
      SubscriptBox["N", "2"]]}]], ",", "     ", 
   SubscriptBox["\[Chi]", "c"], "=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       SqrtBox[
        SubscriptBox["N", "1"]]], "+", 
      FractionBox["1", 
       SqrtBox[
        SubscriptBox["N", "2"]]], ")"}], "2"], "2"]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"8afe09a7-fdb7-41f2-9e5d-cb0a762d1338"],

Cell[TextData[{
 "For a long polymer (",
 StyleBox["N\:2081 = 100",
  FontFamily->"Times",
  FontSlant->Italic],
 ", ",
 StyleBox["N\:2082 = 1",
  FontFamily->"Times",
  FontSlant->Italic],
 "): ",
 StyleBox["\[Phi]\:1d9c = 0.091",
  FontFamily->"Times",
  FontSlant->Italic],
 ", ",
 StyleBox["\[Chi]\:1d9c = 0.605",
  FontFamily->"Times",
  FontSlant->Italic],
 ". The critical concentration is low (~9%), meaning that even dilute polymer \
solutions phase-separate when \[Chi] exceeds a modest threshold."
}], "Text",ExpressionUUID->"7d4fbe4e-7e75-429b-8297-0d71489dd0ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figFHPhaseDiagram", "[", 
  RowBox[{"100", ",", " ", "1"}], "]"}]], "Input",
 CellLabel->" In[7]:=",ExpressionUUID->"93073fe3-dde1-4ecf-a166-b419d520a982"],

