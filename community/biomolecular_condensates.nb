     RowBox[{"\"\<f''=-2\>\"", ",", " ", "\"\<f''=-1\>\"", ",", 
      " ", "\"\<f''=-0.5\>\"", ",", " ", "\"\<f''=+0.5 (stable)\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->
