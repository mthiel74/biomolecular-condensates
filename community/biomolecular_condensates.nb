Cell[CellGroupData[{

Cell["13.  Reproducibility", "Section",ExpressionUUID->"ada5ed7b-7ffa-4439-a224-7df1c2be7caa"],

Cell[TextData[{
 "All source code lives in the repository ",
 StyleBox["github.com/mthiel74/biomolecular-condensates",
  FontWeight->"SemiBold"],
 " (",
 StyleBox["https://github.com/mthiel74/biomolecular-condensates",
  FontFamily->"Courier",
  FontSize->10],
 ")",
 ". The pipeline has two parallel tracks: Wolfram Language (analysis scripts \
in ",
 StyleBox["wolfram/",
  FontFamily->"Courier"],
 " and this notebook builder in ",
 StyleBox["community/",
  FontFamily->"Courier"],
 ") and Python (",
 StyleBox["src/",
  FontFamily->"Courier"],
 ", including a full 2D Cahn\[Dash]Hilliard spectral solver). The figures \
come from both tracks: the Wolfram scripts write directly to ",
 StyleBox["docs/images/",
  FontFamily->"Courier"],
 ", while the Python scripts write to ",
 StyleBox["figures/",
  FontFamily->"Courier"],
 " and are copied across. Wolfram Language 13+ is required. To regenerate \
this notebook from scratch, run the Python track first, then the Wolfram \
runner (which now also executes the Phase-3 companion and copies the Python \
figures into place), then the builder:"
}], "Text",ExpressionUUID->"aeaf5388-e674-48e6-bf46-681dbcf75ef0"],

Cell["\<\
# 1. Python track \[LongRightArrow] writes figures to figures/
pip install -r src/requirements.txt    # numpy, scipy, matplotlib (+ ffmpeg \
for animations)
python3 src/flory_huggins.py
python3 src/cahn_hilliard.py
python3 src/condensate_kinetics.py
python3 src/protocell.py
python3 src/nonlinear_analysis.py        # nonlinear-dynamics analysis (\
\[Section]8)
python3 src/fh_extensions.py             # stickers-and-spacers (\[Section]9.3)
python3 src/active_models.py             # active condensates (\[Section]9)
python3 src/multicomponent.py            # multi-component condensates (\
\[Section]10.1)
python3 src/darwinian_selection.py       # Darwinian selection (\[Section]10.2)
python3 src/reaction_diffusion_cargo.py  # reaction-diffusion \
(\[Section]10.3)
python3 src/wet_dry_cycling.py           # wet-dry cycling (\[Section]10.4)
python3 src/parameter_space.py           # parameter space (\[Section]10.5)
python3 src/phase3_heroes.py             # hero visualisations

# 2. Wolfram analysis + copy of Python figures \[LongRightArrow] docs/images/
wolframscript -file wolfram/run_all.wls

# 3. Rebuild this notebook
wolframscript -file community/build_notebook.wls\
\>", "Program",
 CellMargins->{{60, 30}, {6, 6}},
 ShowStringCharacters->False,
 FontFamily->"Courier",
 FontSize->11,
 Background->RGBColor[
  0.95, 0.96, 0.98],ExpressionUUID->"bd893180-b6b9-4681-b336-d6601cac8135"],

