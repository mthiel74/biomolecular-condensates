Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]", " ", 
       RowBox[{
        RowBox[{"Log", "[", "\[Phi]", "]"}], "/", "n1"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "\[Phi]"}], ")"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"1", " ", "-", " ", "\[Phi]"}], "]"}]}], " ", "+", " ", 
      RowBox[{"\[Chi]", " ", "\[Phi]", " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "\[Phi]"}], ")"}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", " ", "0.001", ",", " ", "0.999"}], "}"}], ",", 
     " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Phi]\>\"", ",", " ", "\"\<f/kT\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", " ", "0.605", ",", " ", "\"\<\[Chi]\>\""}], 
      "}"}], ",", " ", "0.3", ",", " ", "1.6", ",", " ", "0.005"}], "}"}], ",",
    "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n1", ",", " ", "100", ",", " ", "\"\<chain length N\>\""}], 
      "}"}], ",", " ", "1", ",", " ", "300", ",", " ", "1"}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->" In[6]:=",ExpressionUUID->"dfc7dbca-4718-4e2c-a63d-ee4456100c54"],

Cell[OutputFormData["\<\
                   Log[\[CapitalIDoubleDot]\.95]
Manipulate[Plot[\[CapitalIDoubleDot]\.95 ------- + (1 - \[CapitalIDoubleDot]\
\.95) Log[1 - \[CapitalIDoubleDot]\.95] + \[CapitalIDoubleDot]\.87 \
\[CapitalIDoubleDot]\.95 (1 - \[CapitalIDoubleDot]\.95), 
                     n1
 
>    {\[CapitalIDoubleDot]\.95, 0.001, 0.999}, PlotRange -> All, Frame -> \
True, 
 
>    FrameLabel -> {\[CapitalIDoubleDot]\.95, f/kT}, ImageSize -> 480], 
 
>   {{\[CapitalIDoubleDot]\.87, 0.605, \[CapitalIDoubleDot]\.87}, 0.3, 1.6, \
0.005}, 
 
>   {{n1, 100, chain length N}, 1, 300, 1}]\
\>"], "Output",
 CellChangeTimes->{3.991475083618537*^9},
 CellLabel->" Out[6]=",ExpressionUUID->"ddb4ed59-667a-465b-955f-ccba1f58a2b4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2  Spinodal and binodal: the phase diagram", "Subsection",ExpressionUUID->"814ebf62-ab65-4271-a07f-3219cb390b1b"],

Cell[TextData[{
 "The thermodynamic stability of the mixed state is determined by the \
curvature of the free energy. The ",
 StyleBox["spinodal",
  FontWeight->Bold],
 " is the locus of inflection points:"
}], "Text",ExpressionUUID->"94a2ee31-71b0-4d12-83ac-1d6622fb2723"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "2"], "f"}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["\[Phi]", "2"]}]], "=", 
   FractionBox["1", 
    RowBox[{
     SubscriptBox["N", "1"], " ", "\[Phi]"}]], "+", 
   FractionBox["1", 
    RowBox[{
     SubscriptBox["N", "2"], " ", "(", 
     RowBox[{"1", "-", "\[Phi]"}], ")"}]], "-", 
   RowBox[{"2", "\[Chi]"}], "=", "0"}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"11f85307-a772-4eb0-8213-e137f655f568"],

Cell[TextData[{
 "Inside the spinodal, the free energy has negative curvature (",
 StyleBox["\[PartialD]\.b2f/\[PartialD]\[Phi]\.b2 < 0",
  FontFamily->"Times",
  FontSlant->Italic],
 ") and the system is ",
 StyleBox["unstable",
  FontWeight->Bold],
 " to infinitesimal composition fluctuations \[LongDash] this is ",
 StyleBox["spinodal decomposition",
  FontWeight->Bold],
 ". Between the spinodal and the ",
 StyleBox["binodal",
  FontWeight->Bold],
 " (the coexistence curve), the system is ",
 StyleBox["metastable",
  FontWeight->Bold],
 " \[LongDash] it requires a finite-amplitude fluctuation (nucleation) to \
phase-separate."
}], "Text",ExpressionUUID->"336faed6-b7b8-426e-9c9b-a7cafb09c2fd"],

Cell[TextData[{
 "The binodal is found by the ",
 StyleBox["common tangent construction",
  FontWeight->Bold],
 ": the two coexisting compositions \[Phi]\:2097 and \[Phi]\:1d48 satisfy \
equal chemical potential and equal osmotic pressure:"
}], "Text",ExpressionUUID->"337499b3-0677-45aa-b42c-afdf81f8f647"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Mu]", "(", 
    SubscriptBox["\[Phi]", "L"], ")"}], "=", 
   RowBox[{"\[Mu]", "(", 
    SubscriptBox["\[Phi]", "R"], ")"}], ",", "     ", 
   RowBox[{"\[CapitalPi]", "(", 
    SubscriptBox["\[Phi]", "L"], ")"}], "=", 
   RowBox[{"\[CapitalPi]", "(", 
    SubscriptBox["\[Phi]", "R"], ")"}]}], TraditionalForm]], "DisplayFormula",\

 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"14fd0065-7668-4111-be3d-4cd23f6626d9"],

Cell[TextData[{
 "The ",
 StyleBox["critical point",
  FontWeight->Bold],
 " is where the spinodal and binodal meet:"
}], "Text",ExpressionUUID->"a3feef15-6766-42ff-8b7e-aafcacd2ef48"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Phi]", "c"], "=", 
   FractionBox[
    SqrtBox[
     SubscriptBox["N", "2"]], 
    RowBox[{
     SqrtBox[
      SubscriptBox["N", "1"]], "+", 
     SqrtBox[
      SubscriptBox["N", "2"]]}]], ",", "     ", 
   SubscriptBox["\[Chi]", "c"], "=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       SqrtBox[
        SubscriptBox["N", "1"]]], "+", 
      FractionBox["1", 
       SqrtBox[
        SubscriptBox["N", "2"]]], ")"}], "2"], "2"]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"1a1e4efc-7247-459f-8a7e-7c207ec5d844"],

Cell[TextData[{
 "For a long polymer (",
 StyleBox["N\:2081 = 100",
  FontFamily->"Times",
  FontSlant->Italic],
 ", ",
 StyleBox["N\:2082 = 1",
  FontFamily->"Times",
  FontSlant->Italic],
 "): ",
 StyleBox["\[Phi]\:1d9c = 0.091",
  FontFamily->"Times",
  FontSlant->Italic],
 ", ",
 StyleBox["\[Chi]\:1d9c = 0.605",
  FontFamily->"Times",
  FontSlant->Italic],
 ". The critical concentration is low (~9%), meaning that even dilute polymer \
solutions phase-separate when \[Chi] exceeds a modest threshold."
}], "Text",ExpressionUUID->"65a9e4db-3577-4475-aa6a-3e39333ca214"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figFHPhaseDiagram", "[", 
  RowBox[{"100", ",", " ", "1"}], "]"}]], "Input",
 CellLabel->" In[7]:=",ExpressionUUID->"b32f7440-ca90-434d-be93-9a3104a8c9cf"],

