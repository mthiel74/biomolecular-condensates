Cell[CellGroupData[{

Cell["8.2  Mode selection across the parameter plane", "Subsection",ExpressionUUID->"84e0786d-bb40-4fb2-8096-a07f220d88f5"],

Cell[TextData[{
 "The selected wavelength ",
 StyleBox["\[Lambda]* = 2\[Pi] sqrt(2\[Kappa]/(-f\[Prime]\[Prime]))",
  FontFamily->"Times",
  FontSlant->Italic],
 " grows with the surface-tension parameter ",
 StyleBox["\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 " and diverges at the spinodal boundary, where ",
 StyleBox["f\[Prime]\[Prime] \[Rule] 0",
  FontFamily->"Times",
  FontSlant->Italic],
 ". The map below shows how the length scale is selected jointly by \
composition and ",
 StyleBox["\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 "."
}], "Text",ExpressionUUID->"0cfe8f79-6582-448e-b451-ddb646ae1103"],

