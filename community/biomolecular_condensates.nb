Cell["\<\
Figure 2.1  Flory\[Dash]Huggins free energy density for a \
polymer\[Dash]solvent system (N\:2081 = 100, N\:2082 = 1) at several values \
of \[Chi]. Below the critical \[Chi], the free energy has a single minimum \
(stable mixed state). Above it, a double well appears: the system \
phase-separates into dilute (\[Phi]\:2097) and dense (\[Phi]\:1d48) phases at \
the two minima.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"e0c50a6a-85ef-433f-b067-c0e37ccdd352"],

Cell["\<\
Evaluate the cell below to reproduce Figure 2.1 \[LongDash] the whole of \
Flory\[Dash]Huggins is two lines of Wolfram Language:\
\>", "Text",
 FontSlant->Italic,
 FontColor->RGBColor[
  0.153, 0.51, 0.64],ExpressionUUID->"77f92651-21ff-4da9-a35a-df89a5306140"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fFH", "[", 
    RowBox[{
    "\[Phi]_", ",", " ", "n1_", ",", " ", "n2_", ",", " ", "\[Chi]_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{
    RowBox[{"\[Phi]", " ", 
     RowBox[{
      RowBox[{"Log", "[", "\[Phi]", "]"}], "/", "n1"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "\[Phi]"}], ")"}], " ", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"1", " ", "-", " ", "\[Phi]"}], "]"}], "/", "n2"}]}], " ", "+",
     " ", 
    RowBox[{"\[Chi]", " ", "\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "\[Phi]"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"fFH", "[", 
       RowBox[{"\[Phi]", ",", " ", "100", ",", " ", "1", ",", " ", "\[Chi]"}],
        "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[Chi]", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.4", ",", " ", "0.605", ",", " ", "0.9", ",", " ", "1.5"}],
          "}"}]}], "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", " ", "0.001", ",", " ", "0.999"}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.04"}], ",", " ", "0.04"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Phi]\>\"", ",", " ", "\"\<f/kT\>\""}], "}"}]}], ",", "\n",
    "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Chi]=0.4\>\"", ",", " ", "\"\<\[Chi]=0.605 (critical)\>\"",
       ",", " ", "\"\<\[Chi]=0.9\>\"", ",", " ", "\"\<\[Chi]=1.5\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->" In[4]:=",ExpressionUUID->"72f16361-ce47-4ccf-9f25-267e816c171e"],

