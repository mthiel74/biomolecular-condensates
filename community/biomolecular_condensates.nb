Cell["\<\
Figure 2.3  Spinodal curves for different chain lengths. Longer chains \
produce wider two-phase regions at higher temperatures (lower \[Chi] \
threshold). This is why proteins with long disordered regions are prone to \
phase separation.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"cdf24b0d-de0a-400b-90ad-4d71c8674f62"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.  Cahn\[Dash]Hilliard dynamics of droplet formation", "Section",ExpressionUUID->"484ffca3-10e0-42e0-afd7-534700dd70f0"],

Cell[CellGroupData[{

Cell["3.1  The equation", "Subsection",ExpressionUUID->"90b70ae7-8f52-422a-8471-47fac2da76b8"],

Cell[TextData[{
 "The Flory\[Dash]Huggins theory tells us ",
 StyleBox["whether",
  FontSlant->Italic],
 " phase separation occurs, but not ",
 StyleBox["how",
  FontSlant->Italic],
 ". The dynamics of a conserved order parameter (composition must be \
conserved \[LongDash] matter doesn't appear or disappear) are governed by the \
",
 StyleBox["Cahn\[Dash]Hilliard equation",
  FontWeight->Bold],
 ":"
}], "Text",ExpressionUUID->"c539ca97-b5dc-4077-96d3-022290664fe5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "\[Phi]"}], 
    RowBox[{"\[PartialD]", "t"}]], "=", 
   RowBox[{"M", " ", 
    SuperscriptBox["\[Del]", "2"], 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Delta]", "F"}], 
       RowBox[{"\[Delta]", "\[Phi]"}]], "-", 
      RowBox[{"\[Kappa]", " ", 
       SuperscriptBox["\[Del]", "2"], "\[Phi]"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"2b02f017-7f96-4a9f-9732-d3eaec7812d3"],

Cell[TextData[{
 "where ",
 StyleBox["M",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the mobility (diffusion coefficient), ",
 StyleBox["\[Delta]F/\[Delta]\[Phi]",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the chemical potential from the Flory\[Dash]Huggins free energy, and ",
 StyleBox["\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the gradient energy coefficient that penalises sharp interfaces (it \
sets the surface tension \[Gamma] of the condensate)."
}], "Text",ExpressionUUID->"1daa74bf-0f14-4255-b1ee-58cb9d82c13c"],

Cell[TextData[{
 StyleBox["Physical content.",
  FontSlant->Italic],
 " The Cahn\[Dash]Hilliard equation says: material flows down chemical \
potential gradients (as in ordinary diffusion), but the chemical potential \
now includes a penalty for composition gradients (the \[Kappa] term). Inside \
the spinodal region, the bulk chemical potential drives ",
 StyleBox["uphill diffusion",
  FontWeight->Bold],
 " \[LongDash] material flows from dilute to concentrated regions, amplifying \
any fluctuation. The gradient penalty prevents infinitely sharp interfaces \
and selects a characteristic wavelength for the initial instability."
}], "Text",ExpressionUUID->"870d4c5b-709e-476c-969e-860d58549927"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2  Spinodal decomposition", "Subsection",ExpressionUUID->"85adc33d-aff2-45dc-84c9-cced6890bf0e"],

Cell[TextData[{
 "We solve the 1D Cahn\[Dash]Hilliard equation using Wolfram's built-in ",
 StyleBox["NDSolve",
  FontFamily->"Courier"],
 " with the Method of Lines. The Flory\[Dash]Huggins chemical potential is \
logarithmically stiff near the pure phases and the strongly-stabilised 1D \
solver freezes; we therefore use the standard symmetric double-well (Model B) \
order parameter ",
 StyleBox["\[Psi]",
  FontFamily->"Times",
  FontSlant->Italic],
 ", started from a uniform state plus a small multi-mode periodic \
perturbation, and map it to a physical volume fraction ",
 StyleBox["\[Phi] = \[Phi]\:2080 + A\[ThinSpace]\[Psi]",
  FontFamily->"Times",
  FontSlant->Italic],
 " for display."
}], "Text",ExpressionUUID->"9f835bc5-0ca6-4ac7-93b5-ff6a190a8ac0"],

Cell["\<\
mu[\[Psi]_] := -a \[Psi] + b \[Psi]^3;   (* double-well Model B *)
sol = NDSolveValue[{
   D[\[Psi][x, t], t] == M D[
      mu[\[Psi][x, t]] - \[Kappa] D[\[Psi][x, t], x, x], x, x],
   \[Psi][x, 0] == icf[x],            (* smooth periodic perturbation *)
   \[Psi][0, t] == \[Psi][L, t],      (* periodic BCs *)
   \[Psi]'[0, t] == \[Psi]'[L, t]},
   \[Psi], {x, 0, L}, {t, 0, T},
   Method -> {\"MethodOfLines\",
     \"SpatialDiscretization\" -> {\"TensorProductGrid\",
       \"MinPoints\" -> 256}}];\
\>", "Program",
 CellMargins->{{60, 30}, {6, 6}},
 ShowStringCharacters->False,
 FontFamily->"Courier",
 FontSize->11,
 Background->RGBColor[
  0.95, 0.96, 0.98],ExpressionUUID->"98ac0b86-c71d-40db-8b8a-078c7468c073"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figCH1DEvolution", "[", "]"}]], "Input",
 CellLabel->" In[9]:=",ExpressionUUID->"863e58d1-ad22-43c6-bbb1-d4acd5f77ef5"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.991475413807724*^9},
 CellLabel->" Out[9]=",ExpressionUUID->"51f4f4dc-1a51-497b-8591-4a4664f06205"]
}, Open  ]],

Cell["\<\
Figure 3.1  Top: space\[Dash]time density plot of the 1D spinodal \
decomposition. The initially uniform composition rapidly develops \
concentration fluctuations that coarsen into well-separated dense (red) and \
dilute (blue) domains. Bottom: composition profiles at selected times showing \
the progression from small perturbation to fully phase-separated condensates.\
\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"63e437ce-b4d9-40f3-b689-c06878ad762f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3  Coarsening: Lifshitz\[Dash]Slyozov\[Dash]Wagner", "Subsection",ExpressionUUID->"3ca90fc8-6563-4215-b320-6f516e777301"],

Cell[TextData[{
 "Once phase separation is complete, the system continues to evolve: large \
droplets grow at the expense of small ones. This is ",
 StyleBox["Ostwald ripening",
  FontWeight->Bold],
 ", described by the Lifshitz\[Dash]Slyozov\[Dash]Wagner (LSW) theory. The \
critical radius ",
 StyleBox["R*",
  FontFamily->"Times",
  FontSlant->Italic],
 " is set by the Gibbs\[Dash]Thomson equation:"
}], "Text",ExpressionUUID->"cee02da2-bbe8-4d39-93e2-e7245d6c5b98"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "eq"], "(", "R", ")", "=", 
   SubscriptBox["c", "\[Infinity]"], 
   RowBox[{"exp", "(", 
    FractionBox[
     RowBox[{"2", "\[Gamma]", " ", 
      SubscriptBox["V", "m"]}], 
     RowBox[{"R", " ", "k", "T"}]], ")"}], "\[TildeTilde]", 
   SubscriptBox["c", "\[Infinity]"], 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SubscriptBox["l", "c"], "R"]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"2c96588e-d9a1-4ea5-badb-d56489659400"],

Cell[TextData[{
 "Droplets smaller than the critical radius (",
 StyleBox["R < R*",
  FontFamily->"Times",
  FontSlant->Italic],
 ") have an equilibrium concentration above the surrounding matrix \
supersaturation \[LongDash] they lose material and dissolve. Droplets with ",
 StyleBox["R > R*",
  FontFamily->"Times",
  FontSlant->Italic],
 " sit below it \[LongDash] they grow. The mean domain size grows as ",
 StyleBox["\[LeftAngleBracket]R\[RightAngleBracket] \[Proportional] t^(1/3)",
  FontFamily->"Times",
  FontSlant->Italic],
 ", the classic LSW scaling."
}], "Text",ExpressionUUID->"4b0b69b5-45a1-41bc-bc48-9b2d0dd1e263"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figProtoOstwald", "[", "]"}]], "Input",
 CellLabel->
  " In[10]:=",ExpressionUUID->"8f4932c1-f1ff-4de4-8988-1fd05ade443a"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.9914754142028513`*^9},
 CellLabel->
  " Out[10]=",ExpressionUUID->"23401dfc-4c9d-40b2-82cc-3db23f1b1e6d"]
}, Open  ]],

Cell["\<\
Figure 3.2  Ostwald ripening of a polydisperse condensate population (100 \
droplets). Left: the mean and maximum droplet radius grow with time as large \
droplets feed on small ones. Right: the number of surviving droplets falls as \
the smallest dissolve \[LongDash] the hallmark of LSW coarsening (\
\[LeftAngleBracket]R\[RightAngleBracket] \[Proportional] t^(1/3)).\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"a25f56eb-2540-45bf-800e-54b9408c228c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.  Concentration enhancement and catalysis", "Section",ExpressionUUID->"e4db5f59-6f53-4170-b892-8b952eb1d272"],

Cell[CellGroupData[{

Cell["4.1  The partition coefficient", "Subsection",ExpressionUUID->"76e8b077-9a48-4f9d-a584-46a689d7d49d"],

Cell[TextData[{
 "When a condensate forms, molecules partition between the dense and dilute \
phases according to their chemical affinity. The ",
 StyleBox["partition coefficient",
  FontWeight->Bold],
 " ",
 StyleBox["K",
  FontFamily->"Times",
  FontSlant->Italic],
 " is defined as:"
}], "Text",ExpressionUUID->"16e8e7b0-e776-4ef0-baf6-640f1f3ffc36"],

Cell[BoxData[
 FormBox[
  RowBox[{"K", "=", 
   FractionBox[
    SubscriptBox["c", "in"], 
    SubscriptBox["c", "out"]]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"e010c45f-21ab-400e-93c7-7ae4d2e2fbeb"],

Cell["\<\
For condensate-forming proteins, K is typically 10\[Dash]100. For RNA \
molecules that interact strongly with the condensate scaffold, K can reach \
100\[Dash]1000. A molecule at 1 nM bulk concentration with K = 100 is at 100 \
nM inside the condensate. A molecule at 1 nM with K = 1000 is at 1 \[Mu]M. \
This is the concentration miracle.\
\>", "Text",ExpressionUUID->"25111989-d12d-487a-ab69-32386f776435"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2  Bimolecular rate enhancement", "Subsection",ExpressionUUID->"946265b5-e161-44fa-8d8d-b7ad74a4be48"],

Cell[TextData[{
 "For a bimolecular reaction A + B \[Rule] C with second-order rate constant ",
 StyleBox["k",
  FontFamily->"Times",
  FontSlant->Italic],
 ":"
}], "Text",ExpressionUUID->"068fe488-87dc-4f22-a4ec-ef2dd998c1a2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["rate", "dilute"], "=", 
   RowBox[{"k", " ", 
    SubscriptBox[
     RowBox[{"[", "A", "]"}], "out"], " ", 
    SubscriptBox[
     RowBox[{"[", "B", "]"}], "out"]}]}], TraditionalForm]], "DisplayFormula",\

 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"e43c4666-adba-457e-8d8e-e1843684cd7c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["rate", "condensate"], "=", 
   RowBox[{"k", " ", 
    RowBox[{
     SubscriptBox["K", "A"], " ", 
     SubscriptBox[
      RowBox[{"[", "A", "]"}], "out"]}], " ", 
    RowBox[{
     SubscriptBox["K", "B"], " ", 
     SubscriptBox[
      RowBox[{"[", "B", "]"}], "out"]}]}], "=", 
   RowBox[{
    SubscriptBox["K", "A"], " ", 
    SubscriptBox["K", "B"], " ", 
    SubscriptBox["rate", "dilute"]}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"f97b7e07-062c-4886-959a-36b59c6eb62c"],

Cell[TextData[{
 "If both reactants partition equally (",
 StyleBox["K_A \[TildeTilde] K_B \[TildeTilde] K",
  FontFamily->"Times",
  FontSlant->Italic],
 "), the reaction rate is enhanced by ",
 StyleBox["K\.b2",
  FontWeight->Bold],
 ". With K = 100, this is a ",
 StyleBox["10\:2074-fold enhancement",
  FontWeight->Bold],
 ". This is the ",
 StyleBox["open-system",
  FontSlant->Italic],
 " (buffered-reservoir) limit, and it is an upper bound: it assumes the \
surrounding dilute phase is never depleted. As \[Section]8.5 shows, imposing \
mass conservation caps the realised gain at order ",
 StyleBox["K/4",
  FontFamily->"Times",
  FontSlant->Italic],
 ". Even so, the mechanism reframes the concentration problem in prebiotic \
chemistry: you do not need a concentrated primordial soup if you have phase \
separation."
}], "Text",ExpressionUUID->"2fa3bbcc-bb09-421a-821c-e97168a82042"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figRateEnhancement", "[", "]"}]], "Input",
 CellLabel->
  " In[11]:=",ExpressionUUID->"936df398-d8e4-4f3d-a5af-bcf7276f4100"],

Cell[OutputFormData["\<\
Legended[-Graphics-, Placed[LineLegend[{RGBColor[0, 0, 1], 
 
>      RGBColor[1, 0, 0]}, {Bimolecular  (K\[CapitalAHat]\.b2), 
 
>      Termolecular  (K\[CapitalAHat]\.b3, illustrative)}, LabelStyle -> {}, 
 
>     LegendLayout -> Column], Scaled[{0.3, 0.8}], Identity]]\
\>"], "Output",
 CellChangeTimes->{3.991475414227034*^9},
 CellLabel->
  " Out[11]=",ExpressionUUID->"7c689c3b-6509-4a45-b888-ab0eb9432885"]
}, Open  ]],

Cell["\<\
Figure 4.1  Reaction rate enhancement inside condensates as a function of the \
partition coefficient K, in the open-system limit (mass conservation lowers \
the realised gain \[LongDash] see \[Section]8.5). Bimolecular reactions \
(blue) scale as K\.b2; the termolecular curve (red, K\.b3) is shown only to \
illustrate the scaling, as three-body reactions are kinetically negligible in \
solution. At the typical condensate K \[TildeTilde] 100, the bimolecular \
bound is 10\:2074.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"6bef8787-776c-4aa9-86d6-af5e3b18c19b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3  Prebiotic chemistry phase space", "Subsection",ExpressionUUID->"05321f8e-65ca-4438-a7d3-f93709e1d5b8"],

Cell["\<\
Which combinations of partition coefficient and bulk concentration allow net \
chemical production? We map the net replication rate (replication minus \
degradation) across the K\[Dash]c parameter space:\
\>", "Text",ExpressionUUID->"02ce3255-8882-4b65-9996-7b9a3fa28833"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figPrebioticSpace", "[", "1.0", "]"}]], "Input",
 CellLabel->
  " In[12]:=",ExpressionUUID->"c273fc1b-0397-4cb4-91cd-d753d73dea9e"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.991475416182663*^9},
 CellLabel->
  " Out[12]=",ExpressionUUID->"808e29b0-46e3-4e0e-bfd1-22bf717d3470"]
}, Open  ]],

Cell["\<\
Figure 4.2  Net replication rate as a function of partition coefficient K and \
bulk substrate concentration. The black contour marks the boundary between \
net growth (blue) and net decay (red). At low bulk concentrations (the likely \
prebiotic regime), only condensates with K > 50\[Dash]100 support net \
replication.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"00b7535b-4e74-49b8-bf7f-3deb4c14aaee"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.  RNA world inside condensates", "Section",ExpressionUUID->"babf59e5-219b-4cd0-a3c0-33d73b418064"],

Cell[CellGroupData[{

Cell["5.1  Ribozyme kinetics", "Subsection",ExpressionUUID->"50b811d4-b987-4eeb-b263-f1415ddc8d0d"],

Cell[TextData[{
 "The RNA world hypothesis proposes that the first self-replicating molecules \
were RNA ribozymes \[LongDash] RNA molecules that catalyse their own \
replication. The kinetics of ribozyme-catalysed replication follow ",
 StyleBox["Michaelis\[Dash]Menten",
  FontWeight->Bold],
 " saturation:"
}], "Text",ExpressionUUID->"29edbd3b-9820-4b72-a2d6-837ba9c9cadc"],

Cell[BoxData[
 FormBox[
  RowBox[{"v", "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["V", "max"], " ", 
     RowBox[{"[", "S", "]"}]}], 
    RowBox[{
     SubscriptBox["K", "m"], "+", 
     RowBox[{"[", "S", "]"}]}]]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"ee1d3658-c73f-4a7a-8362-964739cd969c"],

Cell[TextData[{
 "Inside a condensate, both the enzyme (ribozyme) and the substrate (template \
RNA) are concentrated by the partition coefficient K. Writing ",
 StyleBox["V\:2098\:2090\:2093",
  FontFamily->"Times",
  FontSlant->Italic],
 " for the dilute-phase maximal rate (itself proportional to enzyme \
concentration), the in-condensate ",
 StyleBox["V\:2098\:2090\:2093",
  FontFamily->"Times",
  FontSlant->Italic],
 " is raised by the factor K (more enzyme) and the substrate concentration \
[S] is likewise raised by K (more substrate):"
}], "Text",ExpressionUUID->"210f4bef-8603-497a-a6bb-c73527459f5c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["v", "condensate"], "=", 
   FractionBox[
    RowBox[{"K", " ", 
     SubscriptBox["V", "max"], " ", "K", " ", 
     RowBox[{"[", "S", "]"}]}], 
    RowBox[{
     SubscriptBox["K", "m"], "+", "K", " ", 
     RowBox[{"[", "S", "]"}]}]]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"0a588f51-3a33-40dd-94ef-659cb15462f8"],

Cell[TextData[{
 "At low substrate concentrations (",
 StyleBox["K [S] \[LessLess] K\:2098",
  FontFamily->"Times",
  FontSlant->Italic],
 "), the rate scales as ",
 StyleBox["K\.b2",
  FontFamily->"Times",
  FontSlant->Italic],
 " \[LongDash] the full bimolecular enhancement. At saturation (",
 StyleBox["K [S] \[GreaterGreater] K\:2098",
  FontFamily->"Times",
  FontSlant->Italic],
 "), the rate scales as K (only the enzyme enhancement matters)."
}], "Text",ExpressionUUID->"acedbfa1-8734-4357-b330-6267c903702c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2  Replication vs degradation", "Subsection",ExpressionUUID->"fc46cd65-527f-4d0e-a8a2-9833bb0749c4"],

Cell[TextData[{
 "RNA is chemically unstable. In the prebiotic ocean, hydrolysis degrades RNA \
on timescales of hours to days. The ",
 StyleBox["origin-of-life window",
  FontWeight->Bold],
 " exists only when the replication rate exceeds the degradation rate:"
}], "Text",ExpressionUUID->"c94af9a3-10c8-43a7-9153-1a2eaaeeb8b1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["v", "rep"], ">", 
   SubscriptBox["v", "deg"], 
   RowBox[{"   ", 
    RowBox[{"\[DoubleLongLeftRightArrow]", "   "}]}], "K", ">", 
   SuperscriptBox["K", "*"]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"6c00af7b-095c-491b-9f1e-9c4c08cf8fc8"],

Cell[TextData[{
 "where ",
 StyleBox["K*",
  FontFamily->"Times",
  FontSlant->Italic],
 " is the critical partition coefficient. Below K*, degradation wins and no \
self-replicating system can persist."
}], "Text",ExpressionUUID->"abdeff68-4bbb-4b9f-8df1-72b05fa91499"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figRibozyme", "[", "0.5", "]"}]], "Input",
 CellLabel->
  " In[13]:=",ExpressionUUID->"d0bd0f1a-09c2-4fab-ab60-d423ffd1731d"],

Cell[OutputFormData["\<\
                                                             1
Legended[-Graphics-, Placed[LineLegend[{Directive[PointSize[---], 
                                                            120
 
>       AbsoluteThickness[2], Thickness[Large], RGBColor[0, 0, 1]], 
 
                            1
>      Directive[PointSize[---], AbsoluteThickness[2], Thickness[Large], 
                           120
 
>       Dashing[{Small, Small}], RGBColor[1, 0, 0]]}, 
 
>     {Replication rate, Degradation rate}, 
 
>     LegendMarkers -> {{False, Automatic}, {False, Automatic}}, 
 
>     Joined -> {True, True}, LabelStyle -> {}, LegendLayout -> Column], 
 
>    After, Identity]]\
\>"], "Output",
 CellChangeTimes->{3.991475416420417*^9},
 CellLabel->
  " Out[13]=",ExpressionUUID->"1c722038-21c4-4716-8143-edd8ed81c24d"]
}, Open  ]],

Cell["\<\
Figure 5.1  Replication (blue) versus degradation (red) rate as a function of \
the partition coefficient K, at fixed bulk substrate [S] = 1 \[Mu]M. \
Replication is enhanced as K\.b2 and degradation as K, so above a critical K* \
the green-shaded origin-of-life window opens: replication outpaces hydrolysis \
and a self-replicating system can persist.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"c65716de-35a4-4e79-b5bb-7549d0285aa9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3  The origin-of-life window", "Subsection",ExpressionUUID->"36362730-0347-40ad-8bcf-9ffac3de49cd"],

Cell["\<\
The critical partition coefficient K* depends on the ribozyme efficiency (V\
\:2098\:2090\:2093/K\:2098), the degradation rate constant, and the substrate \
level. For plausible prebiotic parameters (V\:2098\:2090\:2093 \[TildeTilde] \
1 \[Mu]M/min, K\:2098 \[TildeTilde] 10 \[Mu]M, k\:1d48\:2091\:2092 \
\[TildeTilde] 0.5/min), we find K* \[TildeTilde] 10 at [S] = 1 \[Mu]M, rising \
toward 50\[Dash]100 at the lower substrate levels of a dilute prebiotic pool. \
Modern coacervate droplets routinely achieve K = 50\[Dash]500, comfortably \
above this threshold \[LongDash] the concentration-enhancement mechanism is \
not marginal.\
\>", "Text",ExpressionUUID->"30a68bbf-4c9c-4e77-a149-f41152d25c52"],

Cell["\<\
This is a quantitative version of Oparin's coacervate hypothesis: phase \
separation concentrates reactants enough to bootstrap biochemistry from a \
dilute ocean \[LongDash] though, as \[Section]8.5 shows, mass conservation \
bounds how large that boost can be.\
\>", "Text",ExpressionUUID->"e25deb3d-86b7-4b88-9974-169924be178f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.  Protocell dynamics", "Section",ExpressionUUID->"f234b6aa-31d8-41c8-ae9b-1fb94e33fee5"],

Cell[CellGroupData[{

Cell["6.1  Growth and division", "Subsection",ExpressionUUID->"30571c75-52bd-4e3f-87cb-7d40788b37e7"],

Cell[TextData[{
 "A condensate droplet that sustains net internal replication grows: material \
produced inside increases its volume. A ",
 StyleBox["passive",
  FontSlant->Italic],
 " liquid droplet, however, does not divide on its own \[LongDash] surface \
tension drives it to minimise area, so it stays spherical or coalesces with \
its neighbours. Genuine membrane-free division requires a ",
 StyleBox["non-equilibrium drive",
  FontWeight->Bold],
 ": continuous chemical turnover that destabilises large droplets (Zwicker et \
al. 2017), or an external thermal gradient that pinches a droplet in two (",
 StyleBox["\[Section]9.4",
  FontFamily->"Times",
  FontSlant->Italic],
 "; Ianeselli et al. 2022). In the toy protocell model of this section we \
therefore ",
 StyleBox["impose",
  FontSlant->Italic],
 " division as a simple size threshold \[LongDash] a stand-in for those \
mechanisms \[LongDash] and ask what population dynamics follow."
}], "Text",ExpressionUUID->"84017245-e8e3-4566-8574-9724054801b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figProtoGrowthDivision", "[", "]"}]], "Input",
 CellLabel->
  " In[14]:=",ExpressionUUID->"1d10d1f5-4d0e-4cc4-9803-548176b89f8a"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.9914754164257793`*^9},
 CellLabel->
  " Out[14]=",ExpressionUUID->"58325d23-c8d7-4be4-a512-a56a541bef04"]
}, Open  ]],

Cell["\<\
Figure 6.1  Schematic of the protocell life cycle. Small condensates grow by \
accretion of material from the bulk and by internal replication. When they \
exceed a critical size, an imposed threshold \[LongDash] standing in for the \
chemically- or thermally-driven fission of \[Section]9 \[LongDash] splits \
them into two daughters. Daughters inherit (with variation) the parent's \
composition, including its partition coefficient K and replication \
efficiency. Weaker daughters dissolve; fitter ones survive and grow.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"b7faa4a2-6e12-4a22-aa9a-d98615cb2a38"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2  Proto-Darwinian selection", "Subsection",ExpressionUUID->"6af5844d-f76f-48fb-ba01-1d6f9d4b82aa"],

Cell[TextData[{
 "If daughter droplets inherit their parent's chemical composition \
(approximately), and if that composition affects their fitness (replication \
rate, stability), then we have the three ingredients of natural selection: ",
 StyleBox["variation",
  FontWeight->Bold],
 " (daughters differ slightly from each other), ",
 StyleBox["inheritance",
  FontWeight->Bold],
 " (daughters resemble parents more than random droplets), and ",
 StyleBox["differential fitness",
  FontWeight->Bold],
 " (some compositions grow faster than others). This is ",
 StyleBox["proto-Darwinian selection",
  FontWeight->Bold],
 " \[LongDash] natural selection operating on condensate populations before \
the invention of genetic material."
}], "Text",ExpressionUUID->"2ab4f07f-de04-4abe-b6de-659381788059"],

Cell["\<\
We simulate this by initialising a population of 50 protocells with random \
partition coefficients K and replication rates, then letting them grow, \
divide, compete for resources, and either survive or dissolve:\
\>", "Text",ExpressionUUID->"bb2fbab3-01b7-46f3-a238-2f8188602abf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figProtoSelection", "[", "]"}]], "Input",
 CellLabel->
  " In[15]:=",ExpressionUUID->"58308884-71e6-413f-b752-87a3d8c921f9"],

Cell[OutputFormData["\<\
-Graphics-\
\>"], "Output",
 CellChangeTimes->{3.9914754196844273`*^9},
 CellLabel->
  " Out[15]=",ExpressionUUID->"f9916fb1-3241-4e84-aa43-59eec2b6ec6a"]
}, Open  ]],

Cell["\<\
Figure 6.2  Proto-Darwinian selection in a simulated protocell population. \
Left: mean partition coefficient K increases over time as protocells with \
higher K out-compete those with lower K. Centre: mean replication rate \
increases. Right: lineage depth (max generation number) grows as successful \
lineages proliferate. These trends are the signature of adaptive evolution \
operating on membrane-free liquid droplets.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"50b6e848-22b5-4018-8dc0-1a2da3ee7c07"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.  Condensates and disease", "Section",ExpressionUUID->"baf76354-db6a-4b47-ab02-a121584c8b20"],

Cell[CellGroupData[{

Cell["7.1  Liquid to gel to aggregate", "Subsection",ExpressionUUID->"44ab88af-d3bb-4f51-8b97-95474be705ff"],

Cell[TextData[{
 "Functional condensates are ",
 StyleBox["liquid",
  FontWeight->Bold],
 ": they flow, they exchange material rapidly with the surrounding cytoplasm, \
and they dissolve when the cell no longer needs them. But this liquidity is \
not guaranteed. Over time, or in the presence of disease-associated \
mutations, condensates can undergo a ",
 StyleBox["maturation",
  FontWeight->Bold],
 " transition: liquid \[Rule] gel \[Rule] solid aggregate. The gel state has \
reduced dynamics; the solid aggregate is essentially irreversible."
}], "Text",ExpressionUUID->"6e4aad92-6489-43b5-b373-dd2405618757"],

Cell[TextData[{
 "This maturation is implicated in several ",
 StyleBox["neurodegenerative diseases",
  FontWeight->Bold],
 ", though the pathologies differ. FUS and TDP-43 form functional liquid \
condensates whose mutated or mislocalised forms harden into the cytoplasmic \
",
 StyleBox["inclusions",
  FontWeight->Bold],
 " of ALS and frontotemporal dementia (FTLD); tau matures into the \
neurofibrillary ",
 StyleBox["tangles",
  FontWeight->Bold],
 " of Alzheimer's and other tauopathies. (The amyloid ",
 StyleBox["plaques",
  FontWeight->Bold],
 " of Alzheimer's, by contrast, are built from a different peptide, amyloid-\
\[Beta].) In each case disease mutations or conditions shift the phase \
boundaries, accelerating the liquid\[Rule]gel\[Rule]solid transition toward \
these pathological end states."
}], "Text",ExpressionUUID->"3a44ce7a-af0e-4be1-8774-72aeb07399de"],

Cell["We model this as a three-state kinetic system:", "Text",ExpressionUUID->"e619f068-a36f-4fb6-914e-e6ebc34e75dc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", "liquid", "]"}], 
   OverscriptBox["\[LongRightArrow]", 
    SubscriptBox["k", "gel"]], 
   RowBox[{"[", "gel", "]"}], 
   OverscriptBox["\[LongRightArrow]", 
    SubscriptBox["k", "agg"]], 
   RowBox[{"[", "aggregate", "]"}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"c10bf758-0143-4538-b232-531098540617"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figDiseaseTransition", "[", "]"}]], "Input",
 CellLabel->
  " In[16]:=",ExpressionUUID->"d4a0254c-b25d-400a-aba8-38747fb9bc62"],

Cell[OutputFormData["\<\
Labeled[-Graphics-, Condensate ageing: liquid \[IDoubleDot]\.94\[Cent] gel \
\[IDoubleDot]\.94\[Cent] aggregate\\
 
>    (neurodegeneration), Top]\
\>"], "Output",
 CellChangeTimes->{3.991475419948344*^9},
 CellLabel->
  " Out[16]=",ExpressionUUID->"037892a6-16ea-4313-bfb8-b0b009cb2774"]
}, Open  ]],

Cell["\<\
Figure 7.1  Three kinetic scenarios for condensate ageing. Left: wild-type \
protein with slow maturation (healthy neuron). Centre: risk variant with \
moderate rates. Right: disease mutant (FUS/TDP-43 in ALS) with fast \
maturation \[LongDash] the liquid phase is rapidly depleted, and toxic \
aggregates accumulate.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"7cb3be3e-1b0e-423e-ba6e-7e6e287c91d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2  Phase diagram of material states", "Subsection",ExpressionUUID->"e72892ac-2592-4605-a359-936f9ff84cdb"],

Cell["\<\
The condensate material state depends on protein concentration and \
temperature (or interaction strength). We construct a schematic phase diagram \
showing the four regimes: mixed (one phase), liquid condensate, gel, and \
solid aggregate. Disease mutations effectively shift the boundaries, \
expanding the gel and aggregate regions at the expense of the functional \
liquid state.\
\>", "Text",ExpressionUUID->"7411b81c-e6ad-40e7-83f7-a51efa6debff"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"figDiseasePhaseDiagram", "[", "]"}]], "Input",
 CellLabel->
  " In[17]:=",ExpressionUUID->"182906e1-8378-4c88-ba56-08f727f05ff6"],

Cell[OutputFormData["\<\
                                                            1
Legended[-Graphics-, Placed[LineLegend[{Directive[PointSize[--], 
                                                            90
 
>       AbsoluteThickness[2], Thickness[Large], RGBColor[0, 0, 1]], 
 
                           1
>      Directive[PointSize[--], AbsoluteThickness[2], Thickness[Large], 
                           90
 
                                                  1
>       RGBColor[1, 0.5, 0]], Directive[PointSize[--], AbsoluteThickness[2], 
                                                  90
 
>       Thickness[Large], RGBColor[1, 0, 0]]}, 
 
>     {Liquid condensate, Gel transition, Solid aggregate}, 
 
>     LegendMarkers -> 
 
>      {{False, Automatic}, {False, Automatic}, {False, Automatic}}, 
 
>     Joined -> {True, True, True}, LabelStyle -> {}, LegendLayout -> Column]\\
 
>     , After, Identity]]\
\>"], "Output",
 CellChangeTimes->{3.9914754200142508`*^9},
 CellLabel->
  " Out[17]=",ExpressionUUID->"cc1c467c-a602-437c-b680-81c97b93cf56"]
}, Open  ]],

Cell["\<\
Figure 7.2  Condensate material state phase diagram. Higher concentration and \
lower temperature (stronger interactions) drive the progression from mixed \
solution to liquid condensate to gel to solid aggregate. Disease mutations \
shift the boundaries toward lower concentrations and higher temperatures, \
making pathological aggregation more likely.\
\>", "Text",
 CellMargins->{{70, 70}, {2, 14}},
 FontSize->11,
 FontSlant->Italic,
 FontColor->GrayLevel[
  0.35],ExpressionUUID->"190ae080-fce1-4dec-9ba3-560d964fc966"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
8.  Nonlinear dynamics: stability, bifurcation, and coarsening\
\>", "Section",ExpressionUUID->"c8986404-2d18-4ef0-9666-584dd21a67a0"],

Cell[TextData[{
 "The previous sections built the model; here we analyse it with the toolkit \
of ",
 StyleBox["nonlinear dynamics",
  FontWeight->Bold],
 " \[LongDash] linear stability, bifurcation theory, Lyapunov functionals, \
and scaling laws. Every figure in this section is generated by ",
 StyleBox["wolfram/nonlinear_dynamics.wls",
  FontFamily->"Courier"],
 " (with a parallel Python implementation in ",
 StyleBox["src/nonlinear_analysis.py",
  FontFamily->"Courier"],
 ")."
}], "Text",ExpressionUUID->"a09b923c-4bb9-41e6-9772-c46ba5a7e4e1"],

Cell[CellGroupData[{

Cell["8.1  Linear stability and the dispersion relation", "Subsection",ExpressionUUID->"4cea3c29-877d-4544-9962-a1729ba22b31"],

Cell[TextData[{
 "Linearise the Cahn\[Dash]Hilliard equation about a uniform state ",
 StyleBox["\[Phi] = \[Phi]\:2080 + \[Delta]\[ThinSpace]exp(i\[ThinSpace]k\
\[CenterDot]x + \[Omega]t)",
  FontFamily->"Times",
  FontSlant->Italic],
 ". Each Fourier mode grows or decays independently at the rate"
}], "Text",ExpressionUUID->"e8c46cef-03eb-4f35-a6e5-a27c76428db0"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Omega]", "(", "k", ")", "=", 
   RowBox[{"-", "M", " ", 
    SuperscriptBox["k", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["f", "\[Prime]\[Prime]"], "(", 
      SubscriptBox["\[Phi]", "0"], ")", "+", "\[Kappa]", " ", 
      SuperscriptBox["k", "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{80, 50}, {8, 
  8}},ExpressionUUID->"2f9c88e4-9153-42fb-9979-abe4fc0877d5"],

Cell[TextData[{
 "A uniform state is ",
 StyleBox["unstable",
  FontWeight->Bold],
 " precisely when ",
 StyleBox["f\[Prime]\[Prime](\[Phi]\:2080) < 0",
  FontFamily->"Times",
  FontSlant->Italic],
 " \[LongDash] the ",
 StyleBox["spinodal",
  FontWeight->Bold],
 " condition \[LongDash] in which case modes with ",
 StyleBox["0 < k < k_c = sqrt(-f\[Prime]\[Prime]/\[Kappa])",
  FontFamily->"Times",
  FontSlant->Italic],
 " grow. The fastest-growing mode and its rate are ",
 StyleBox["k* = sqrt(-f\[Prime]\[Prime]/2\[Kappa])",
  FontFamily->"Times",
  FontSlant->Italic],
 " and ",
 StyleBox["\[Omega]* = M (f\[Prime]\[Prime])\.b2/4\[Kappa]",
  FontFamily->"Times",
  FontSlant->Italic],
 ", setting the initial droplet spacing ",
 StyleBox["\[Lambda]* = 2\[Pi]/k*",
  FontFamily->"Times",
  FontSlant->Italic],
 ". This single mode is the seed of all condensate morphology."
}], "Text",ExpressionUUID->"42a6c54c-93a6-4132-acea-81342e4d1f9b"],

Cell[TextData[{
 "The dispersion relation, live \[LongDash] the positive lobe (and hence the \
fastest-growing mode) appears exactly when ",
 StyleBox["f\[Prime]\[Prime] < 0",
  FontFamily->"Times",
  FontSlant->Italic],
 ":"
}], "Text",
 FontSlant->Italic,
 FontColor->RGBColor[
  0.153, 0.51, 0.64],ExpressionUUID->"860d7fb1-6bbb-4a64-8763-1e59147c46ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", "[", 
    RowBox[{"k_", ",", " ", "fpp_", ",", " ", "M_", ",", " ", "\[Kappa]_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "M"}], " ", 
    RowBox[{"k", "^", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"fpp", " ", "+", " ", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"k", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\[Omega]", "[", 
       RowBox[{"k", ",", " ", "fpp", ",", " ", "1", ",", " ", "1"}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"fpp", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "2."}], ",", " ", 
          RowBox[{"-", "1."}], ",", " ", 
          RowBox[{"-", "0.5"}], ",", " ", "0.5"}], "}"}]}], "}"}]}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", " ", "1.6"}], "}"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", " ", "\"\<\[Omega](k)\>\""}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
