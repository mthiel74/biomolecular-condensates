Cell[BoxData[
 RowBox[{"figReactionEnhancement", "[", "]"}]], "Input",
 CellLabel->
  " In[24]:=",ExpressionUUID->"d6907bfb-a50b-4531-81c2-7c0c7bacaf22"],

Cell[OutputFormData["\<\
-Graphics-\
